{
  "name": "nexus-hub",
  "version": "1.3.1",
  "private": true,
  "description": "Your second screen. Your command center.",
  "author": "Nexus Hub",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "npm run build:native && node scripts/dev.mjs",
    "build:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "dist": "npm run build:native && npm run build && electron-builder --win nsis --x64",
    "pack": "npm run build:native && npm run build && electron-builder --win dir --x64"
  },
  "build": {
    "appId": "nl.nexushub.desktop",
    "productName": "Nexus Hub",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "**/*",
          "!webview2/**",
          "!AppHost.*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nexus Hub"
    },
    "artifactName": "Nexus-Hub-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "matix-codex",
        "repo": "Nexus-Hub",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "^1.40.0",
    "openrgb-sdk": "0.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "systeminformation": "^5.33.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "vite": "^8.2.2"
  }
}
